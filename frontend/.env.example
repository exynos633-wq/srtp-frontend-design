# 前端公开配置示例。
# 使用方法：复制为 .env.local（已被 .gitignore 忽略），按需修改后重启 dev server。
#
# 注意：VITE_ 前缀的变量会被写入浏览器构建产物，只能放可公开的信息。
# 供应商密钥、服务器口令、后台管理员密码一律不得写入前端或本文件。

# 站名（暂用“建筑模型展厅”，Logo 与正式名称待定）
VITE_APP_NAME=建筑模型展厅

# 业务 API 基址；真实地址与路径由后端确认（接口契约仍为草案）
VITE_API_BASE_URL=/api

# 开发 Mock 开关：默认 false。只有开发构建（import.meta.env.DEV）且为 true 时启动 MSW；
# 生产构建恒走真实 HTTP，失败不得回退到模拟数据。
# 演示账号 admin / admin 只存在于 Mock 中，不是真实凭据。
VITE_ENABLE_MOCKS=false
